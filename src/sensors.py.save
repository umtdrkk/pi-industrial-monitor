≈≈import random
import time
from config.settings import RUNNING_ON_PI, SENSOR_CHANNELS


def read_sensors():
    if RUNNING_ON_PI:
        return _read_real_sensors()
    else:
        return _read_fake_sensors()


# ── CONVERTERS ──────────────────────────────────────────
# Each converter takes a voltage at the ADC and returns a dict
# with the real-world value. Add a new sensor type by writing
# one new function and registering it below.

def _convert_voltage(voltage_at_adc):
        current_ma = round(voltage_at_adc / 150 * 1000, 3)
        percent = round((current_ma - 4.0) / 16.0 * 100, 1)
        return {"value": current_ma, "percent": percent, "unit": "mA"}


def _convert_current(voltage_at_adc):
    voltage_at_shunt = voltage_at_adc * 2.0
    current_ma = round(voltage_at_shunt / 250 * 1000, 3)
    percent = round((current_ma - 4.0) / 16.0 * 100, 1)
    return {"value": current_ma, "percent": percent, "unit": "mA"}


CONVERTERS = {
    "voltage": _convert_voltage,
    "current": _convert_current,
}

FAKE_ADC_RANGES = {
    "voltage": (0.0, 3.1),
    "current": (0.5, 2.5),
}


# ── FAKE DATA (development) ──────────────────────────────

def _read_fake_sensors():
    readings = []
    for channel in SENSOR_CHANNELS:
        ch_type = channel["type"]
        converter = CONVERTERS.get(ch_type)

        if converter is None:
            print(f"Warning: unknown sensor type '{ch_type}' for channel {channel['id']}, skipping")
            continue

        adc_range = FAKE_ADC_RANGES.get(ch_type, (0.0, 3.3))
        fake_voltage_at_adc = random.uniform(*adc_range)

        result = converter(fake_voltage_at_adc)

        readings.append({
            "id": channel["id"],
            "name": channel["name"],
            "type": ch_type,
            "category": channel.get("category", "default"),
            "timestamp": time.time(),
            **result
        })
    return readings


# ── REAL DATA (Raspberry Pi with MCP3208) ────────────────

def _read_real_sensors():
    import spidev
    spi = spidev.SpiDev()
    readings = []

    for channel in SENSOR_CHANNELS:
        ch_type = channel["type"]
        converter = CONVERTERS.get(ch_type)

        if converter is None:
            print(f"Warning: unknown sensor type '{ch_type}' for channel {channel['id']}, skipping")
            continue

        chip = 0 if channel["id"] <= 8 else 1
        ch_num = (channel["id"] - 1) % 8

        spi.open(0, chip)
        spi.max_speed_hz = 1350000

        cmd = [0x06 | ((ch_num & 0x04) >> 2), (ch_num & 0x03) << 6, 0x00]
        response = spi.xfer2(cmd)
        raw = ((response[1] & 0x0F) << 8) | response[2]

        spi.close()

        voltage_at_adc = raw * (3.3 / 4096)

        result = converter(voltage_at_adc)

        readings.append({
            "id": channel["id"],
            "name": channel["name"],
            "type": ch_type,
            "category": channel.get("category", "default"),
            "timestamp": time.time(),
            **result
        })

    return readings
